[
{"key": "http_status", "re": "^HTTP (?<code>\\d+), expected (?<want>.+)$"},
{"key": "conn_refused", "re": "^connection refused$"},
{"key": "timeout", "re": "^no response within the timeout$"},
{"key": "host_unreachable", "re": "^host unreachable$"},
{"key": "no_route", "re": "^no route from this host \\(.*\\)$"},
{"key": "filtered", "re": "^blocked by a firewall \\(administratively prohibited\\)$"},
{"key": "conn_reset", "re": "^connection reset by the peer$"},
{"key": "nxdomain", "re": "^(?<name>\\S+) does not resolve \\(no such name\\)$"},
{"key": "dns_resolve", "re": "^cannot resolve (?<name>[^:\\s]+): .*$"},
{"key": "cert_untrusted", "re": "^certificate rejected: not issued by a trusted authority \\(self-signed\\?\\)$"},
{"key": "cert_name", "re": "^certificate rejected: issued for another name \\((?<names>.*)\\)$"},
{"key": "cert_expired", "re": "^certificate rejected: expired$"},
{"key": "cert_not_yet", "re": "^certificate rejected: not valid yet$"},
{"key": "cert_rejected", "re": "^certificate rejected(: .*)?$"},
{"key": "tls_handshake", "re": "^TLS handshake failed.*$"},
{"key": "redirects", "re": "^too many redirects \\(more than 10\\)$"},
{"key": "cert_expired_ago", "re": "^certificate expired (?<days>-?\\d+) days ago$"},
{"key": "cert_critical", "re": "^certificate expires in (?<days>-?\\d+) days \\(critical below (?<crit>\\d+)\\)$"},
{"key": "cert_soon", "re": "^(?<inner>.+); certificate expires in (?<days>-?\\d+) days$"},
{"key": "keyword_missing", "re": "^keyword (?<kw>\".*\") not found in the response$"},
{"key": "keyword_unwanted", "re": "^unwanted text (?<kw>\".*\") found in the response$"},
{"key": "regex_mismatch", "re": "^response does not match (?<re>.+)$"},
{"key": "ping_none", "re": "^no reply to (?<n>\\d+) echo requests$"},
{"key": "ping_ok", "re": "^(?<got>\\d+)/(?<n>\\d+) replies, avg (?<ms>[\\d.]+) ms$"},
{"key": "ping_loss", "re": "^packet loss (?<loss>\\d+)% above (?<max>\\d+)%$"},
{"key": "ping_tcp_ok", "re": "^answered on TCP port (?<port>\\d+) in (?<ms>[\\d.]+) ms \\(checked over TCP: ping is not allowed for this process\\)$"},
{"key": "ping_tcp_unreachable", "re": "^host unreachable \\(checked over TCP: ping is not allowed for this process\\)$"},
{"key": "ping_privilege", "re": "^ping is not allowed for this process: .*$"},
{"key": "dns_no_answer", "re": "^no answer contains (?<want>\".*\") \\(got (?<got>.*)\\)$"},
{"key": "dns_min_answers", "re": "^(?<n>\\d+) answers, expected at least (?<min>\\d+)$"},
{"key": "udp_unreachable", "re": "^ICMP port unreachable: nothing listens on that UDP port$"},
{"key": "no_push", "re": "^no push for (?<d>.+)$"},
{"key": "w_reflection", "re": "^(?<kw>\\S+) replies can be abused for reflection; add authorized=yes if this is your own device$"},
{"key": "w_secret", "re": "^(?<k>\\S+) looks like a credential written in clear text; use \\$\\{secret:NAME\\}$"},
{"key": "w_timeout", "re": "^timeout (?<t>\\S+) is not shorter than the interval (?<i>\\S+)$"},
{"key": "w_unlimited", "re": "^max=0 sends notifications without limit$"},
{"key": "w_stateful", "re": "^(?<kw>\\S+) creates state on the target: interval raised to (?<i>\\S+)$"},
{"key": "w_empty_select", "re": "^MAINT (?<name>\\S+) selects no monitor$"}
]
