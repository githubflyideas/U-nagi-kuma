[
{"name": "ntfy", "label": "ntfy",
 "fields": [{"key": "server", "type": "url", "default": "https://ntfy.sh"}, {"key": "topic", "type": "text", "required": true}, {"key": "token", "type": "secret"}],
 "method": "POST", "url": "{{.server}}/{{pathescape .topic}}", "content_type": "text",
 "headers": {"Title": "{{.Title}}", "Priority": "{{if eq .Priority \"low\"}}default{{else if eq .Kind \"RECOVERY\"}}default{{else}}high{{end}}", "Tags": "{{if eq .Kind \"RECOVERY\"}}white_check_mark{{else}}rotating_light{{end}}", "Authorization": "{{if .token}}Bearer {{.token}}{{end}}"},
 "body": "{{.Body}}"},
{"name": "gotify", "label": "Gotify",
 "fields": [{"key": "server", "type": "url", "required": true}, {"key": "token", "type": "secret", "required": true}],
 "method": "POST", "url": "{{.server}}/message?token={{urlquery .token}}", "content_type": "json",
 "body": "{\"title\":\"{{.Title}}\",\"message\":\"{{.Body}}\",\"priority\":{{if eq .Priority \"low\"}}4{{else}}8{{end}}}"},
{"name": "bark", "label": "Bark",
 "fields": [{"key": "server", "type": "url", "default": "https://api.day.app"}, {"key": "device-key", "type": "secret", "required": true}],
 "method": "POST", "url": "{{.server}}/push", "content_type": "json",
 "body": "{\"device_key\":\"{{index . \"device-key\"}}\",\"title\":\"{{.Title}}\",\"body\":\"{{.Body}}\",\"group\":\"unagikuma\"}",
 "success": {"field": "code", "equals": "200"}},
{"name": "pushover", "label": "Pushover",
 "fields": [{"key": "token", "type": "secret", "required": true}, {"key": "user-key", "type": "secret", "required": true}],
 "method": "POST", "url": "https://api.pushover.net/1/messages.json", "content_type": "json",
 "body": "{\"token\":\"{{.token}}\",\"user\":\"{{index . \"user-key\"}}\",\"title\":\"{{.Title}}\",\"message\":\"{{.Body}}\",\"priority\":{{if eq .Priority \"low\"}}0{{else}}1{{end}}}",
 "success": {"field": "status", "equals": "1"}},
{"name": "serverchan", "label": "ServerChan (Server 酱)",
 "fields": [{"key": "sendkey", "type": "secret", "required": true}],
 "method": "POST", "url": "https://sctapi.ftqq.com/{{pathescape .sendkey}}.send", "content_type": "json",
 "body": "{\"title\":\"{{.Title}}\",\"desp\":\"{{.Body}}\"}",
 "success": {"field": "code", "equals": "0"}},
{"name": "pushplus", "label": "PushPlus",
 "fields": [{"key": "token", "type": "secret", "required": true}],
 "method": "POST", "url": "https://www.pushplus.plus/send", "content_type": "json",
 "body": "{\"token\":\"{{.token}}\",\"title\":\"{{.Title}}\",\"content\":\"{{.Body}}\",\"template\":\"txt\"}",
 "success": {"field": "code", "equals": "200"}},
{"name": "teams", "label": "Microsoft Teams (Workflows)",
 "fields": [{"key": "url", "type": "secret", "required": true}],
 "method": "POST", "url": "{{.url}}", "content_type": "json",
 "body": "{\"type\":\"message\",\"attachments\":[{\"contentType\":\"application/vnd.microsoft.card.adaptive\",\"content\":{\"type\":\"AdaptiveCard\",\"version\":\"1.4\",\"body\":[{\"type\":\"TextBlock\",\"text\":\"{{.Title}}\",\"weight\":\"bolder\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"{{.Body}}\",\"wrap\":true}]}}]}"},
{"name": "matrix", "label": "Matrix",
 "fields": [{"key": "homeserver", "type": "url", "required": true}, {"key": "token", "type": "secret", "required": true}, {"key": "room", "type": "text", "required": true}],
 "method": "PUT", "url": "{{.homeserver}}/_matrix/client/v3/rooms/{{pathescape .room}}/send/m.room.message/{{.DeliveryID}}", "content_type": "json",
 "headers": {"Authorization": "Bearer {{.token}}"},
 "body": "{\"msgtype\":\"m.text\",\"body\":\"{{.Text}}\"}"},
{"name": "mattermost", "label": "Mattermost",
 "fields": [{"key": "url", "type": "secret", "required": true}],
 "method": "POST", "url": "{{.url}}", "content_type": "json",
 "body": "{\"text\":\"{{.Text}}\"}"},
{"name": "pagerduty", "label": "PagerDuty (Events v2)",
 "fields": [{"key": "routing-key", "type": "secret", "required": true}],
 "method": "POST", "url": "https://events.pagerduty.com/v2/enqueue", "content_type": "json",
 "body": "{\"routing_key\":\"{{index . \"routing-key\"}}\",\"event_action\":\"{{if eq .Kind \"RECOVERY\"}}resolve{{else}}trigger{{end}}\",\"dedup_key\":\"unagikuma-{{if .IncidentID}}{{.IncidentID}}{{else}}{{.DeliveryID}}{{end}}\",\"payload\":{\"summary\":\"{{.Title}}\",\"source\":\"{{if .Instance}}{{.Instance}}{{else}}unagikuma{{end}}\",\"severity\":\"{{if eq .Priority \"low\"}}warning{{else}}critical{{end}}\",\"custom_details\":{\"body\":\"{{.Body}}\"}}}"},
{"name": "opsgenie", "label": "Opsgenie",
 "fields": [{"key": "api-key", "type": "secret", "required": true}, {"key": "region", "type": "select", "options": ["us", "eu"], "default": "us"}],
 "method": "POST", "url": "https://api.{{if eq .region \"eu\"}}eu.{{end}}opsgenie.com/v2/alerts{{if eq .Kind \"RECOVERY\"}}/unagikuma-{{.IncidentID}}/close?identifierType=alias{{end}}", "content_type": "json",
 "headers": {"Authorization": "GenieKey {{index . \"api-key\"}}"},
 "body": "{{if eq .Kind \"RECOVERY\"}}{\"note\":\"{{.Title}}\"}{{else}}{\"message\":\"{{trunc 120 .Title}}\",\"alias\":\"unagikuma-{{if .IncidentID}}{{.IncidentID}}{{else}}{{.DeliveryID}}{{end}}\",\"description\":\"{{.Body}}\",\"priority\":\"{{if eq .Priority \"low\"}}P3{{else}}P1{{end}}\"}{{end}}"},
{"name": "googlechat", "label": "Google Chat",
 "fields": [{"key": "url", "type": "secret", "required": true}],
 "method": "POST", "url": "{{.url}}", "content_type": "json",
 "body": "{\"text\":\"{{.Text}}\"}"}
]
